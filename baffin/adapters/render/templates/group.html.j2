{% extends "base.html.j2" %}
{% block title %}{{ group.label }} — {{ site.title }}{% endblock %}
{% macro group_nav() %}
<nav class="group-nav">
  <span class="group-nav-prev">
    {%- if prev %}<a href="{{ prev.href }}">‹ {{ prev.label }}</a>{% endif -%}
  </span>
  <a class="group-nav-up" href="{{ home_href }}">All groups</a>
  <span class="group-nav-next">
    {%- if next %}<a href="{{ next.href }}">{{ next.label }} ›</a>{% endif -%}
  </span>
</nav>
{% endmacro %}
{% block main %}
<h1>{{ group.label }}</h1>
{{ group_nav() }}
<div class="grid" id="gallery">
{% for a in assets %}
  <a class="cell" href="{{ a.href }}"{% if a.kind == "video" %} data-video="1"{% endif %}
     {%- if a.switch %} data-tiers='{{ a.switch | tojson }}'{% endif %}
     {%- if a.full %} data-full="{{ a.full }}"{% endif %}
     {%- if a.name %} data-name="{{ a.name }}"{% endif %}>
    <img src="{{ a.thumb }}"
         {% if a.srcset %}srcset="{{ a.srcset }}" sizes="(max-width: 600px) 45vw, 300px"{% endif %}
         {% if a.width %}width="{{ a.width }}" height="{{ a.height }}"{% endif %}
         loading="lazy" alt="{{ a.alt }}">
  </a>
{% endfor %}
</div>
{{ group_nav() }}
{% endblock %}
